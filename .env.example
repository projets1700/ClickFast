# Modèle de configuration : copier vers .env et remplacer les valeurs.
# Le .env contient les vraies valeurs et n'est jamais commité.

# Connexion de l'API à la base (lues aussi pour créer l'utilisateur Postgres)
DB_HOST=clickfast-db
DB_PORT=5432
DB_USER=clickfast
DB_PASSWORD=change_moi
DB_NAME=clickfast

# URL de l'API vue par le navigateur du joueur (pas par les conteneurs)
API_URL=http://localhost:3000
